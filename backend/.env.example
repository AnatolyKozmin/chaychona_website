DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/restaurant_training
JWT_SECRET_KEY=change_me_to_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BOOTSTRAP_SUPERADMIN_EMAIL=owner@example.com
BOOTSTRAP_SUPERADMIN_PASSWORD=change_me_please
CONTENT_EXPORT_ROOT=/absolute/path/to/content_export
# Фоновая генерация видео блюд (фото ингредиентов + озвучка → mp4)
FFMPEG_BINARY=ffmpeg
VIDEO_WORKER_ENABLED=true
VIDEO_WORKER_POLL_SECONDS=3
VIDEO_WORKER_TIMEOUT_SECONDS=600

# Генерация картинки ингредиентов при заливе меню файлом.
# Ключ — в кабинете Magnific (бывший Freepik API). Без него стадия «картинка»
# падает с понятной ошибкой, текст и фото из архива заезжают всё равно.
MAGNIFIC_API_KEY=
MAGNIFIC_API_BASE=https://api.magnific.com
# Стиль внутри Mystic, а не имя эндпоинта. Допустимы только realism / fluid /
# zen / flexible / super_real / editorial_portraits — прочее API отвергает.
MAGNIFIC_IMAGE_MODEL=realism

# Озвучка. В REST API Magnific text-to-speech нет — их TTS доступен только из
# веба и по MCP, серверу туда не попасть. Поэтому провайдер выбирается здесь:
#   elevenlabs — те же голоса, что в Magnific, НО закрыт для российских IP
#                (отвечает 302 на статью про страновые ограничения);
#   yandex     — SpeechKit, работает из России и платится рублями.
# Что бы вы ни выбрали, проверьте через scripts/check_generation.py до залива.
TTS_PROVIDER=elevenlabs

ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# Yandex SpeechKit — используется при TTS_PROVIDER=yandex.
# FOLDER_ID нужен, только если ключ не привязан к сервисному аккаунту.
# Голоса: alena, filipp, ermil, jane, omazh, zahar.
YANDEX_TTS_API_KEY=
YANDEX_TTS_API_BASE=https://tts.api.cloud.yandex.net
YANDEX_TTS_FOLDER_ID=
YANDEX_TTS_VOICE=alena
YANDEX_TTS_LANG=ru-RU

# Потолок ожидания внешнего провайдера на одно задание генерации.
GENERATION_TIMEOUT_SECONDS=300
